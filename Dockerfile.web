# B站数据看板 - Web版 Docker镜像
FROM python:3.11-slim

LABEL maintainer="前线观察大队"

# 安装Python依赖
RUN pip install --no-cache-dir flask requests

WORKDIR /app

# 创建数据目录
RUN mkdir -p /app/data/avatars /app/data/reports

# 复制Web应用
COPY web_app.py .
COPY templates templates

EXPOSE 5000

CMD ["python", "web_app.py"]
